APP_ENV=production
APP_NAME=SAKRA VISION Backend
APP_VERSION=1.0.0

ALLOWED_ORIGINS=https://your-vercel-frontend-domain.vercel.app,https://sakra-vision.online

SECRET_TOKEN=your_secret_token_here

DB_HOST=your-aiven-host
DB_PORT=3306
DB_NAME=sakra
DB_USER=your-aiven-user
DB_PASSWORD=your-aiven-password
DB_SSL_CA=your-aiven-ca-certificate-or-path

RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=your_verified_resend_email
RESEND_TO_EMAIL=likith.anumakonda@gmail.com

GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant
GROQ_MAX_TOKENS=700
GROQ_TEMPERATURE=0.3

TRUST_PROXY=true
CLOUDFLARE_API_TOKEN=your_cloudflare_token_if_needed
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id_if_needed

RATE_LIMIT_CLIENTS=10/minute
RATE_LIMIT_CHAT=10/minute
REQUEST_BODY_LIMIT_BYTES=102400
