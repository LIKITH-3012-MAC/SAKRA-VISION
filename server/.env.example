# ==============================================================================
# SAKRA VISION — Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env in the server directory and populate the actual values.
# NEVER commit the .env file or any database credentials to version control.

# Application Server
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# MySQL Database Configuration (Aiven Cloud MySQL or local MySQL)
# Required variables:
#   DB_HOST: Database hostname (e.g., mysql-xxxxxx-xxxx.aivencloud.com)
#   DB_PORT: Port number (e.g., 20000+ for Aiven, 3306 for local)
#   DB_NAME: Database name (e.g., sakra_stocks or defaultdb)
#   DB_USER: Username (e.g., avnadmin for Aiven, root for local)
#   DB_PASSWORD: User password
#   DB_SSL: Enable TLS/SSL connection (true/false). Required for Aiven.
#   DB_SSL_CA_PATH: Absolute or relative path to the Aiven Project CA Certificate (.pem)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sakra_stocks
DB_USER=root
DB_PASSWORD=
DB_SSL=false
DB_SSL_CA_PATH=

# AI Provider — Official Groq API Only (Strictly NO local Ollama)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Web Research Integration — Firecrawl API
FIRECRAWL_API_KEY=

# Groww Market Data Integration (Credentials optional; live access unverified)
GROWW_API_KEY=
GROWW_ACCESS_TOKEN=

# Market Data Mode: 'historical' (Tej Bazaar / Bhavcopy) or 'live' (Groww)
MARKET_DATA_MODE=historical
